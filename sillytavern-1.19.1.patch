+/**
+ * @param {import('express').Request} request SillyTavern request with an optional image API URL.
+ * @returns {{baseUrl?: string, options?: import('node-fetch').RequestInit} | null} API override, or null for an invalid URL.
+ */
+function getNovelImageApi(request) {
+    const value = request.body?.image_api_url;
+    if (value === undefined || value === '') return {};
+    if (typeof value !== 'string' || !/^https?:\/\//i.test(value) || !URL.canParse(value)) return null;
+
+    const url = new URL(value);
+    if (url.username || url.password || /[?#]/.test(url.href)) return null;
+
+    return {
+        baseUrl: url.href.replace(/\/+$/, ''),
+        options: {
+            redirect: 'error',
+            // Administrators can use a local image server, subject to the configured private address filter.
+            agent: request.user.profile.admin ? undefined : getUntrustedRequestAgent(),
+        },
+    };
+}
+
+async function readNovelImage(result, customApi) {
+    if (customApi) {
+        const type = result.headers.get('content-type')?.split(';')[0].trim().toLowerCase();
+        if (type === 'application/json' || type === 'image/png') {
+            let image;
+            if (type === 'application/json') {
+                const data = await result.json();
+                const base64 = data?.images?.[0]?.image;
+                if (typeof base64 !== 'string') return null;
+                image = Buffer.from(base64, 'base64');
+            } else {
+                image = Buffer.from(await result.arrayBuffer());
+            }
+            return image.subarray(0, PNG_SIGNATURE.length).equals(PNG_SIGNATURE) ? image : null;
+        }
+    }
+
+    return extractFileFromZipBuffer(await result.arrayBuffer(), '.png');
+}
